; ============================================================================
; Guidance Office — custom NSIS installer extension (electron-builder)
;
; Branded wizard matching the app's design system:
;   * school-blue #1a3a6b / navy #0d2347 / gold #c9a227 palette
;   * Segoe UI typography, branded welcome text
;   * branded sidebar + header bitmaps (generated by make_installer_assets.ps1,
;     wired via installerSidebar/installerHeader in package.json)
;   * a custom "Shortcuts" page styled like the app's cards, letting users pick:
;       - Desktop shortcut   (checked by default)
;       - Pin to taskbar     (best-effort — see note below)
;
; The Start Menu shortcut is always created (managed by electron-builder via
; createStartMenuShortcut in package.json).
;
; NOTE on taskbar pinning: Windows 10/11 removed the programmatic pin API.
; We create the shortcut in the "User Pinned\TaskBar" folder, which works on
; many configurations; on some systems the pin only appears after Explorer
; refreshes (sign-out / restart). Users can always pin manually too.
; ============================================================================

!include "LogicLib.nsh"
!include "WinMessages.nsh"
!include "nsDialogs.nsh"

; ---------------------------------------------------------------------------
; Brand colors (NSIS uses BGR hex)
; ---------------------------------------------------------------------------
!define BRAND_NAVY      0x6B3A1A   ; #1a3a6b school blue
!define BRAND_NAVY_DARK 0x47230D   ; #0d2347
!define BRAND_GOLD      0x27A2C9   ; #c9a227
!define BRAND_SOFT      0xF7EEE8   ; #e8eef7 accent-soft
!define BRAND_INK       0x120D0A   ; #0a0d12 text
!define BRAND_MUTED     0xA6A09A   ; #5c6470 muted text

; ---------------------------------------------------------------------------
; MUI branding — these defines apply before MUI pages are inserted
; ---------------------------------------------------------------------------
; !define MUI_FONT "Segoe UI" 9   ; DISABLED: !define takes max 3 tokens, and MUI_FONT
;                                  is not a real MUI2 define anyway. NSIS 3.x already
;                                  renders the wizard in Segoe UI via its built-in
;                                  $(^Font) language string, so no override is needed.
!define MUI_ABORTWARNING

; The same MUI define names are used for the installer AND the uninstaller
; pass (the script is compiled twice; the uninstall pass defines
; BUILD_UNINSTALLER). Give each pass its own copy so the uninstall wizard
; never shows "Welcome to the Setup" / "Launch now" text.
!ifndef BUILD_UNINSTALLER
  ; --- Installer wording -----------------------------------------------------
  !define MUI_WELCOMEPAGE_TITLE "Welcome to the Guidance Office Setup"
  !define MUI_WELCOMEPAGE_TEXT "This wizard will install Guidance Office — Records & Inventory Management System on your computer.$\r$\n$\r$\nA desktop companion to the school's guidance records: student profiles, counseling sessions, referrals, and inventory — all in one calm place.$\r$\n$\r$\nClick Next to continue."

  ; Header copy for the built-in pages
  !define MUI_DIRECTORYPAGE_TEXT_TOP "Choose where Guidance Office will be installed."

  ; Finish page copy
  !define MUI_FINISHPAGE_TITLE "Guidance Office is ready"
  !define MUI_FINISHPAGE_TEXT "Setup has finished installing Guidance Office on your computer.$\r$\n$\r$\nLaunch it to sign in with your guidance office account."
  ; Note: MUI_FINISHPAGE_RUN itself is left to electron-builder (it points it at
  ; the app exe); we only restyle the checkbox label.
  !define MUI_FINISHPAGE_RUN_TEXT "Launch Guidance Office now"
!else
  ; --- Uninstaller wording ---------------------------------------------------
  !define MUI_WELCOMEPAGE_TITLE "Uninstall Guidance Office"
  !define MUI_WELCOMEPAGE_TEXT "This wizard will remove Guidance Office from this computer.$\r$\n$\r$\nYour records are stored on the school server and are NOT deleted here — only the desktop app and its shortcuts are removed.$\r$\n$\r$\nClick Next to continue."

  !define MUI_FINISHPAGE_TITLE "Guidance Office has been removed"
  !define MUI_FINISHPAGE_TEXT "Setup has finished uninstalling Guidance Office from this computer.$\r$\n$\r$\nYou can reinstall it at any time."
!endif

; Installer pass only — unused vars in the uninstaller pass trigger NSIS
; warning 6001, which electron-builder treats as an error.
!ifndef BUILD_UNINSTALLER
Var ShortcutDialog
Var DesktopCheckbox
Var TaskbarCheckbox
Var WantDesktop
Var WantTaskbar
Var CardHandle
Var HeadingFont
Var SubFont
!endif

; --- Register the custom page ------------------------------------------------
; customHeader is inserted AFTER all MUI pages (Welcome..Finish), which put the
; shortcuts page after the install had already run — too late to matter and the
; wizard was already in its finished state. customPageAfterChangeDir is the hook
; electron-builder provides for a page between "choose directory" and the
; install itself, which is exactly where the shortcut choices belong. It is
; also only inserted in the installer pass, so the uninstaller never shows it.
; !macro customHeader
;   Page custom CustomShortcutsPage CustomShortcutsPageLeave
; !macroend
!macro customPageAfterChangeDir
  Page custom CustomShortcutsPage CustomShortcutsPageLeave
!macroend

; --- Page UI ----------------------------------------------------------------
; Installer pass only — in the uninstaller pass these functions would be
; unreferenced and NSIS warning 6010 (treated as error) would fail the build.
!ifndef BUILD_UNINSTALLER
Function CustomShortcutsPage
  nsDialogs::Create 1018
  Pop $ShortcutDialog
  ${If} $ShortcutDialog == error
    Abort
  ${EndIf}

  ; Typography
  CreateFont $HeadingFont "Segoe UI" 11 700
  CreateFont $SubFont "Segoe UI" 8

  ; --- Gold accent bar (brand touch, like the app's card headers) ---
  ${NSD_CreateLabel} 0 0 100% 3u ""
  Pop $0
  SetCtlColors $0 "" ${BRAND_GOLD}

  ; --- Page heading ---
  ${NSD_CreateLabel} 0 10u 100% 14u "Choose where you want shortcuts to be created"
  Pop $0
  SendMessage $0 ${WM_SETFONT} $HeadingFont 0
  SetCtlColors $0 ${BRAND_NAVY} transparent

  ; --- Helper copy ---
  ${NSD_CreateLabel} 0 26u 100% 16u "A Start Menu shortcut is always created. Pick any extras below — you can change your mind later from the desktop itself."
  Pop $0
  SendMessage $0 ${WM_SETFONT} $SubFont 0
  SetCtlColors $0 ${BRAND_MUTED} transparent

  ; --- Card panel (soft-blue surface, like app cards) ---
  ${NSD_CreateLabel} 0 48u 100% 68u ""
  Pop $CardHandle
  SetCtlColors $CardHandle "" ${BRAND_SOFT}

  ; --- Desktop shortcut option ---
  ${NSD_CreateCheckbox} 10u 58u 90% 12u "Create a desktop shortcut"
  Pop $DesktopCheckbox
  SendMessage $DesktopCheckbox ${BM_SETCHECK} ${BST_CHECKED} 0
  SetCtlColors $DesktopCheckbox ${BRAND_INK} ${BRAND_SOFT}

  ${NSD_CreateLabel} 22u 70u 85% 10u "One-click access from your desktop"
  Pop $0
  SendMessage $0 ${WM_SETFONT} $SubFont 0
  SetCtlColors $0 ${BRAND_MUTED} ${BRAND_SOFT}

  ; --- Taskbar option ---
  ${NSD_CreateCheckbox} 10u 86u 90% 12u "Pin to the taskbar"
  Pop $TaskbarCheckbox
  SetCtlColors $TaskbarCheckbox ${BRAND_INK} ${BRAND_SOFT}

  ${NSD_CreateLabel} 22u 98u 85% 12u "Best-effort: on some Windows 10/11 systems the pin only appears after a restart"
  Pop $0
  SendMessage $0 ${WM_SETFONT} $SubFont 0
  SetCtlColors $0 ${BRAND_MUTED} ${BRAND_SOFT}

  ; --- Footer note ---
  ${NSD_CreateLabel} 0 126u 100% 10u "Guidance Office · Records & Inventory Management System"
  Pop $0
  SendMessage $0 ${WM_SETFONT} $SubFont 0
  SetCtlColors $0 ${BRAND_MUTED} transparent

  nsDialogs::Show
FunctionEnd

; --- Collect choices when the user clicks Next ------------------------------
Function CustomShortcutsPageLeave
  ${NSD_GetState} $DesktopCheckbox $WantDesktop
  ${NSD_GetState} $TaskbarCheckbox $WantTaskbar
FunctionEnd
!endif

; --- Create shortcuts during installation -----------------------------------
!macro customInstall
  ${If} $WantDesktop == ${BST_CHECKED}
    CreateShortcut "$DESKTOP\${PRODUCT_NAME}.lnk" "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
  ${EndIf}

  ${If} $WantTaskbar == ${BST_CHECKED}
    CreateShortcut "$APPDATA\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar\${PRODUCT_NAME}.lnk" "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
  ${EndIf}
!macroend

; --- Clean up shortcuts on uninstall -----------------------------------------
!macro customUnInstall
  Delete "$DESKTOP\${PRODUCT_NAME}.lnk"
  Delete "$APPDATA\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar\${PRODUCT_NAME}.lnk"
!macroend
